{
  "manifest_version": 3,
  "name": "MediBill RMV — Emisión Autofill",
  "version": "1.0",
  "description": "Completa automáticamente el formulario de clientes en e-Misión",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["https://facturador.emision.co/*"],
  "externally_connectable": {
    "matches": ["https://medibill-rmv.vercel.app/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MediBill RMV"
  },
  "content_scripts": [
    {
      "matches": ["https://facturador.emision.co/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
