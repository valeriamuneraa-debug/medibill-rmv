{
  "manifest_version": 3,
  "name": "MediBill RMV",
  "version": "1.0.0",
  "description": "Captura rápida de pacientes para el Dr. Rodrigo Múnera Vélez",
  "action": {
    "default_popup": "popup.html",
    "default_title": "MediBill RMV"
  },
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
